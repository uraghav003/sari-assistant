{
  "name": "sari-assistant",
  "private": true,
  "version": "4.1.1",
  "description": "SARI — Sovereign Personal Virtual AI Assistant, Computer Friend & Multi-Agent Swarm Orchestrator for Divyanshi Capital",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "daemon": "node sari-daemon.js",
    "vercel:dev": "vercel dev --local --listen 3001 --yes",
    "test": "npm run typecheck && npm run build",
    "test:api": "npx tsx test-endpoints.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepush": "npm run lint && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.80.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vercel/node": "^29.0.1",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.4",
    "path-to-regexp": "^8.0.0",
    "undici": "^6.29.1",
    "minimatch": "^11.0.4",
    "glob": "^14.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
