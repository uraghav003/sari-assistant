{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "hub": {
    "name": "omp-ruflo-ai-hub",
    "version": "3.0.0",
    "port": 3000,
    "host": "127.0.0.1",
    "protocol": "http-sse",
    "endpoint": "http://127.0.0.1:3000"
  },
  "swarm": {
    "topology": "hierarchical-mesh",
    "strategy": "adaptive",
    "maxAgents": 15,
    "v3Mode": true,
    "autoScale": true,
    "coordinationStrategy": "consensus",
    "leader": "sari",
    "apsc": {
      "live": true,
      "minActiveAgents": 3,
      "pheromoneAdaptive": true,
      "quorumThreshold": 0.67
    }
  },
  "memory": {
    "backend": "hybrid",
    "vectorSearch": true,
    "autoPersist": true,
    "persistPath": ".claude-flow/data",
    "agentDb": {
      "enabled": true,
      "provider": "agentdb-vector",
      "path": ".claude-flow/data/agentdb.sqlite",
      "hnsw": {
        "enabled": true,
        "dimensions": 384,
        "similarityMetric": "cosine",
        "m": 16,
        "efConstruction": 200
      },
      "retrieval": {
        "strategy": "hybrid",
        "smartRetrieval": true,
        "rrf": true,
        "mmr": true,
        "threshold": 0.2
      }
    },
    "namespaces": [
      "default",
      "swarm",
      "episodes",
      "reasoning_bank",
      "banking-ops"
    ]
  },
  "agents": {
    "architect": {
      "id": "architect",
      "name": "Architect",
      "role": "Chief Systems Architect & Technical Specification Designer",
      "archetype": "system-architect",
      "skillsCount": 31,
      "capabilities": [
        "system-architecture",
        "api-design",
        "domain-modeling",
        "codebase-design",
        "slice-decomposition",
        "adr-documentation",
        "spec-mining"
      ],
      "tools": [
        "find",
        "grep",
        "glob",
        "read",
        "edit",
        "write",
        "task"
      ],
      "executionStrategy": "hierarchical-planner"
    },
    "bulbhul": {
